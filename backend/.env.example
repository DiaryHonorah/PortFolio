# =====================================================
# CONFIGURATION — Fichier exemple
# Copier ce fichier en ".env" et remplir les valeurs
# =====================================================

# ===== Base de données =====
DB_HOST=localhost
DB_NAME=cybercafe_db
DB_USER=root
DB_PASS=

# ===== Emails =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME="PortFolio"
MAIL_TO=your_email@gmail.com

# ===== Environnement =====
APP_ENV=development
APP_URL=http://localhost/cybercafe-wifi
FORCE_HTTPS=false